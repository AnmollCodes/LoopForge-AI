# Copy this file to .env and fill in real values.
# .env itself is git-ignored — never commit real secrets.

# Optional. If set, every /api/* route requires this exact value in an
# x-api-key header. Leave unset for local-only use. Generate a real one with:
#   openssl rand -hex 24
API_KEY=

# Port the server listens on. Most hosting platforms (Render, Fly, Railway)
# set this automatically — only override for local use if 3000 is taken.
PORT=3000

# "production" enables stricter security headers and disables the
# unauthenticated-mode startup warning noise in logs. Leave as
# "development" for local use.
NODE_ENV=development
